DATABASE_URL=postgres://project_intelligence:replace-me@localhost:5432/project_intelligence
BOOTSTRAP_EMAIL=owner@example.com
# First-run account password. Preferred: store only its hash. Run `npm run auth:secure-env`
# (or SWA Accounts > "Hash the password stored in .env") to replace a plain-text
# BOOTSTRAP_PASSWORD with BOOTSTRAP_PASSWORD_HASH. Either one only creates the BOOTSTRAP_EMAIL
# account if it doesn't exist yet; it never changes an existing account's password.
BOOTSTRAP_PASSWORD=replace-with-a-long-private-password
# BOOTSTRAP_PASSWORD_HASH=scrypt$<salt>$<hash>
BOOTSTRAP_DISPLAY_NAME=Safety Professional
SESSION_SECRET=replace-with-a-random-secret
LOCAL_STORAGE_DIR=.data/source-objects
PORT=4174
